<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="com.coloros.smartsidebar" />
        <package android:name="com.tencent.mobileqq" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!--
      @author bomo App → Hook 进程的配置推送权限（签名级）。
      只有与模块同签名的应用能持有它；Hook 进程注册接收器时要求该权限，
      于是「发送方是谁」由框架判定，不依赖 getSentFromUid（对普通应用恒为 -1）。
    -->
    <permission
        android:name="com.eta.aicybox.permission.CONFIG_PUSH"
        android:protectionLevel="signature" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" />
    <uses-permission android:name="com.eta.aicybox.permission.CONFIG_PUSH" />
    <!-- @author bomo 气泡位置调节编辑器：App 悬浮窗（欧泡式），需 SYSTEM_ALERT_WINDOW -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- @author bomo 2026-10-19 侧滑索引移植：配置走 Settings.Secure 通道（写需要这条；没授予时退化成 root settings 命令） -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- @author bomo 气泡模板：普通 App 悬浮窗（不需要 Root / LSPosed），装完即生效。 -->

    <application
        android:name=".FlymeFreeformApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FlymeFreeform">

        <activity
            android:name=".MainActivity"
            android:enableOnBackInvokedCallback="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 气泡位置调节编辑器（欧泡式：可拖气泡 + 重置/取消/确认） -->
        <activity
            android:name=".bubble.BubblePosEditActivity"
            android:exported="false"
            android:theme="@style/Theme.EtaBubbleEdit"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- @author bomo 2026-10-19 侧滑索引（从 com.eta.sideindexx 移植进来）：设置页 + 应用选择器 + 配置通道 -->
        <activity
            android:name=".sideindex.settings.SettingsActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".sideindex.settings.AppPickerActivity"
            android:exported="false"
            android:label="@string/pick_app"
            android:theme="@style/AppTheme" />

        <provider
            android:name=".sideindex.settings.ConfigProvider"
            android:authorities="com.eta.aicybox.sideindex.config"
            android:enabled="true"
            android:exported="true" />

        <!--
          Hook 进程（system_server / 侧边栏）的远端配置是只读的，共享状态（最近小窗、工具目录）
          改由它们广播、本 App 落盘。导出注册才能接收其它 UID 的广播，载荷在接收端做校验。
        -->
        <receiver
            android:name=".framework.SharedStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.eta.aicybox.action.SHARED_STATE" />
            </intent-filter>
        </receiver>

        <!-- @author bomo 2026-10-19：QQ 消息通知监听（需求2：来消息弹气泡跳聊天框）。不 hook QQ，用系统通知接口。 -->
        <service
            android:name=".framework.QqNotificationListener"
            android:label="Frash Box 消息提醒"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
